<%- include('../partials/header') %>

<% function formatCurrency(paise) { return '₹' + (paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } %>
<% function formatDate(iso) { if (!iso) return '—'; const d = new Date(iso + 'T00:00:00'); return d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }); } %>

<div class="card" style="padding: 0; overflow: hidden;">
    <div class="section-header" style="padding: 20px 24px;">
        <h2 class="section-title">All Bills</h2>
        <a href="/bills/new" class="btn btn-primary">+ New Bill</a>
    </div>
    
    <div style="padding: 0 24px 20px;">
        <input type="text" id="search-input" class="form-input" placeholder="Search by Serial # or Client Name..." style="max-width: 400px;">
    </div>

    <div class="table-wrapper">
        <table class="data-table" id="bills-table">
            <thead>
                <tr>
                    <th>Serial #</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% if (bills && bills.length > 0) { %>
                    <% bills.forEach(function(bill) { %>
                    <tr style="cursor:pointer;" onclick="window.location.href='/bills/<%= bill._id %>'" class="bill-row">
                        <td style="font-weight:600; color:var(--text-primary);" class="col-serial"><%= bill.serial_number %></td>
                        <td class="col-client"><%= bill.client_name || 'Unknown' %></td>
                        <td><%= formatDate(bill.bill_date) %></td>
                        <td style="text-align:right; font-weight:600;"><%= formatCurrency(bill.grand_total) %></td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr id="empty-row">
                        <td colspan="4" style="text-align:center; padding:40px; color:var(--text-muted);">
                            No bills found. <a href="/bills/new" style="color:var(--accent); font-weight:600;">Create your first bill →</a>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    document.getElementById('search-input').addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.bill-row');
        let count = 0;
        
        rows.forEach(row => {
            const serial = row.querySelector('.col-serial').textContent.toLowerCase();
            const client = row.querySelector('.col-client').textContent.toLowerCase();
            if (serial.includes(query) || client.includes(query)) {
                row.style.display = '';
                count++;
            } else {
                row.style.display = 'none';
            }
        });
        
        // Handle empty state if no search results (optional implementation)
    });
</script>

<%- include('../partials/footer') %>
