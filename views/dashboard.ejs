<%- include('partials/header') %>

<% function formatCurrency(paise) { return '₹' + (paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } %>
<% function formatDate(iso) { if (!iso) return '—'; const d = new Date(iso + 'T00:00:00'); return d.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }); } %>

<!-- Metrics Grid -->
<div class="metrics-grid">
    <div class="metric-card revenue">
        <div class="metric-label">Total Revenue</div>
        <div class="metric-value"><%= formatCurrency(totalRevenue) %></div>
        <div class="metric-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12"/><path d="M6 8h12"/><path d="M6 13h3"/><path d="M9 13c6.667 0 6.667-10 0-10"/><path d="m6 13 8.5 8"/></svg>
        </div>
    </div>
    <div class="metric-card paid">
        <div class="metric-label">Total Bills</div>
        <div class="metric-value"><%= totalBills %></div>
        <div class="metric-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
        </div>
    </div>
</div>

<!-- Recent Bills -->
<div class="card" style="padding: 0; overflow: hidden;">
    <div class="section-header" style="padding: 20px 24px 0;">
        <h2 class="section-title">Recent Bills</h2>
        <a href="/bills" class="btn btn-secondary btn-sm">View All</a>
    </div>
    <div class="table-wrapper" style="padding: 12px 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Invoice Number</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th style="text-align:right;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% if (recentBills && recentBills.length > 0) { %>
                    <% recentBills.forEach(function(bill) { %>
                    <tr style="cursor:pointer;" onclick="window.location.href='/bills/<%= bill._id %>'">
                        <td style="font-weight:600; color:var(--text-primary);"><%= bill.serial_number %></td>
                        <td><%= bill.client_name || 'Unknown' %></td>
                        <td><%= formatDate(bill.bill_date) %></td>
                        <td style="text-align:right; font-weight:600;"><%= formatCurrency(bill.grand_total) %></td>
                    </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="4" style="text-align:center; padding:40px; color:var(--text-muted);">
                            No bills yet. <a href="/bills/new" style="color:var(--accent); font-weight:600;">Create your first bill →</a>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>
